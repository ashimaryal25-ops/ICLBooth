# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dev-server*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# local booth runtime data. The trailing glob matters: timestamped safety copies
# (.booth-storage.bak-YYYYmmdd-HHMMSS) are NOT matched by ".booth-storage/" and
# would otherwise be staged by "git add -A" - they hold guests' card photos.
.booth-storage*
